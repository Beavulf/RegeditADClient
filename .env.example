# Backend HTTP + WebSocket
VITE_SERVER_ADDRESS=localhost
VITE_SERVER_PORT=3000

# GraphQL endpoint (Apollo Client)
VITE_APP_URI_GRAPHQL=http://localhost:3000/graphql

# Service credentials used to obtain a token for GraphQL requests
# (do not commit real credentials; store only locally in `.env`)
VITE_APP_ADMIN_LOGIN=admin
VITE_APP_ADMIN_PASSWORD=change_me

# UI / meta
VITE_DATE_UPDATE=2026-02-27

# Optional: internal references / directories (depends on your environment)
VITE_SPRAV_MRT=\\\\server\\share\\path\\to\\doc.docx

